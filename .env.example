# ─── Mode (TRIPLE-LOCK to go live — ALL three required) ────────────────────────
# Live trading toggle — false = paper (default and safe)
# true = real money (requires all three live gates)
LIVE_MODE=false
# Going live needs ALL of: (1) LIVE_MODE=true  (2) LIVE_CONFIRM=YES  (3) a valid
# validation/paper_validation.json. LIVE_MODE=true ALONE does nothing.
LIVE_CONFIRM=                  # must be exactly YES (plus the validation record)
ALLOW_TAKER=false              # crypto stays false; maker-first

# ─── Polymarket CLOB / auth ─────────────────────────────────────────────────────
POLYMARKET_PRIVATE_KEY=        # signer key for the trading wallet (NEVER commit)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_FUNDER_ADDRESS=     # proxy / funder address that holds USDC
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# ─── Resolution + price feeds ───────────────────────────────────────────────────
# Resolution feed is detected per market from its rules text at discovery
# (Chainlink or Binance). Spot WS is also used for volatility estimation.
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com   # optional secondary spot feed

# 5m/15m markets resolve on the Chainlink BTC/USD data stream — this is resolution
# truth, not spot. Default source "rtds" needs NO credentials: Polymarket relays the
# Chainlink stream publicly via wss://ws-live-data.polymarket.com (topic
# crypto_prices_chainlink). Set "direct" + the URL/key below to use your own
# Chainlink Data Streams access (sponsored key for 15m traders:
# https://pm-ds-request.streams.chain.link/).
CHAINLINK_SOURCE=rtds          # rtds | direct
# direct mode (Data Streams) needs all three; feed ID from data.chain.link/streams/btc-usd
CHAINLINK_STREAM_API_KEY=
CHAINLINK_STREAM_API_SECRET=
CHAINLINK_FEED_ID=

# ─── Perp data for drift signals (optional) ─────────────────────────────────────
GATEIO_API_BASE=https://api.gateio.ws   # funding rate / OI deltas (micro-nudges only)

# ─── Notifications (optional) ───────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Monitoring ─────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ─── Risk caps (can also live in config file) ───────────────────────────────────
# Entry-price ceiling = MAX_TRADE_USD / 5-share floor. $2.6 -> trades up to $0.52;
# $1.5 -> up to $0.30; $1.0 -> up to $0.20. Must be >= 5*MAX_ENTRY_PRICE.
MAX_TRADE_USD=2.6
MAX_CONCURRENT_POSITIONS=3
KELLY_FRACTION=0.25

# ─── Entry-price band ───────────────────────────────────────────────────────────
# Only trade where the fill price is in [MIN, MAX]. Defaults 0.0/1.0 (off).
# 0.31/0.52 = trade ONLY the 31-52c spot (skip cheaper tails); needs MAX_TRADE_USD>=2.6.
MIN_ENTRY_PRICE=0.31
MAX_ENTRY_PRICE=0.52

# ─── Offline-backtest data capture ──────────────────────────────────────────────
# Record resolution price + book tops to data/*.csv (gitignored) so a true-edge
# backtest (recorded books, not synthetic) is possible later. Default off.
RECORD_DATA=false
